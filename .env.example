# ============================================================
# BHUVI Environment Configuration Template
# Copy this file to .env and configure for your local environment.
# Never commit credentials to version control.
# ============================================================

# Application Environment
NODE_ENV=development

# Service Ports
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002

# Authentication & Security (Module 02)
# In production, JWT_SECRET must be at least 32 characters and non-trivial
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=15m

# Set to true only in development/test environments when running without PostgreSQL.
# In production, this MUST be false; InMemory repository is blocked.
AUTH_DEV_MODE=false

# Database Configuration (Module 03 - PostgreSQL 16)
DATABASE_URL=postgresql://bhuvi:bhuvi_dev_password@localhost:5432/bhuvi

# Redis Configuration (Module 03 - Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Ollama AI Engine (Module 05)
OLLAMA_BASE_URL=http://localhost:11434
