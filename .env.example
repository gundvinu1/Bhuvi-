# ============================================================
# BHUVI Environment Configuration Template
# Copy this file to .env and configure for your local environment.
# Never commit credentials to version control.
# ============================================================

# Application Environment
NODE_ENV=development

# Service Ports
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002

# Authentication & Security (Module 02)
# In production, JWT_SECRET must be at least 32 characters and non-trivial
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=15m

# Set to true only in development/test environments when running without PostgreSQL.
# In production, this MUST be false; InMemory repository is blocked.
AUTH_DEV_MODE=false

# Database Configuration (Module 03 - PostgreSQL 16)
DATABASE_URL=postgresql://bhuvi:bhuvi_dev_password@localhost:5432/bhuvi

# Redis Configuration (Module 03 - Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Ollama AI Engine (Module 05 & 08)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Gmail Integration (Module 09)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/gmail/oauth2/callback
GOOGLE_OAUTH_SCOPES=openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_SYNC_INTERVAL_MINUTES=15
GMAIL_SYNC_BATCH_SIZE=50

