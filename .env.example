# ============================================================
# BHUVI Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ============================================================

# Application
NODE_ENV=development

# Ports
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002

# Authentication & Security (Module 02)
# Production requires a cryptographically strong secret at least 32 characters
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=15m
# Set to true only in development when using the in-memory adapter; production must set to false
AUTH_DEV_MODE=false

# Database (Module 03 – not active yet)
DATABASE_URL=postgresql://bhuvi:changeme@localhost:5432/bhuvi_dev

# Redis (Module 03 – not active yet)
REDIS_URL=redis://localhost:6379

# Ollama (Module 05 – not active yet)
OLLAMA_BASE_URL=http://localhost:11434

# Security / Session (Future modules)
SESSION_SECRET=change_this_to_a_secure_random_string_at_least_32_chars
