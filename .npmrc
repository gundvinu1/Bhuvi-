# pnpm configuration for BHUVI
# pnpm 12 uses --allow-build CLI flag or the allowBuilds setting
# This file configures the project-level pnpm behavior

# Hoist packages to make them available in all workspaces
shamefully-hoist=false

# Allow lifecycle scripts for specific trusted packages
allow-build=@nestjs/core,prisma,@prisma/client,@prisma/engines,msgpackr-extract
