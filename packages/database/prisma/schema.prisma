// ============================================================
// BHUVI – Prisma Schema
// Module 03: Database & Infrastructure Foundation
// Module 06: AI Agent Orchestrator Foundation
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// User account model for BHUVI identity and authentication
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plans        AgentPlan[]
  approvals    ApprovalRequest[]
  messages     Message[]
  actionItems  MessageActionItem[]
  labels       MessageLabel[]
  memories     Memory[]
  memoryChunks MemoryChunk[]
  memoryTags   MemoryTag[]
  accessLogs   MemoryAccessLog[]

  @@index([email])
  @@map("users")
}

/// Orchestrated AI plan generated from a user prompt
model AgentPlan {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  title               String
  prompt              String
  intentCategory      String   @map("intent_category")
  status              String   @default("PENDING")
  clarificationNeeded Boolean  @default(false) @map("clarification_needed")
  explanation         String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps               AgentPlanStep[]
  executions          AgentExecution[]
  approvals           ApprovalRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("agent_plans")
}

/// Individual step within an orchestrated AI plan
model AgentPlanStep {
  id               String    @id @default(uuid())
  planId           String    @map("plan_id")
  stepIndex        Int       @map("step_index")
  stepKey          String    @map("step_key")
  title            String
  description      String
  assignedAgent    String    @map("assigned_agent")
  dependencies     String[]  @default([])
  status           String    @default("PENDING")
  requiresApproval Boolean   @default(false) @map("requires_approval")
  output           Json?
  error            String?
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")

  plan             AgentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  approvals        ApprovalRequest[]

  @@unique([planId, stepKey])
  @@index([planId])
  @@index([status])
  @@map("agent_plan_steps")
}

/// Execution tracking run for an AI plan
model AgentExecution {
  id            String    @id @default(uuid())
  planId        String    @map("plan_id")
  status        String    @default("RUNNING")
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  error         String?
  triggerSource String    @default("MANUAL") @map("trigger_source")
  logs          Json?

  plan          AgentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
  @@map("agent_executions")
}

/// Human approval request for sensitive proposals
model ApprovalRequest {
  id             String    @id @default(uuid())
  planId         String    @map("plan_id")
  stepId         String?   @map("step_id")
  userId         String    @map("user_id")
  actionType     String    @map("action_type")
  description    String
  proposalData   Json      @map("proposal_data")
  status         String    @default("PENDING")
  decisionReason String?   @map("decision_reason")
  decidedBy      String?   @map("decided_by")
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           AgentPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  step           AgentPlanStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("approval_requests")
}

// ============================================================
// Module 07: Message Intelligence Engine
// ============================================================

/// Ingested message model for intelligence processing
model Message {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  source           String   @default("MANUAL")
  senderName       String   @map("sender_name")
  senderIdentifier String?  @map("sender_identifier")
  subject          String?
  content          String
  contentHash      String   @map("content_hash")
  processingStatus String   @default("RECEIVED") @map("processing_status")
  receivedAt       DateTime @default(now()) @map("received_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis         MessageAnalysis?
  actionItems      MessageActionItem[]
  labelAssignments MessageLabelAssignment[]

  @@index([userId])
  @@index([processingStatus])
  @@index([receivedAt])
  @@index([userId, contentHash])
  @@map("messages")
}

/// Structured AI analysis for an ingested message
model MessageAnalysis {
  id                  String   @id @default(uuid())
  messageId           String   @unique @map("message_id")
  category            String
  priority            String
  priorityExplanation String?  @map("priority_explanation")
  urgency             String
  intent              String
  sentiment           String
  summary             String
  requiresReply       Boolean  @default(false) @map("requires_reply")
  requiresAction      Boolean  @default(false) @map("requires_action")
  confidence          Float    @default(0.0)
  extractedEntities   Json     @default("[]") @map("extracted_entities")
  analysisMetadata    Json?    @map("analysis_metadata")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  message             Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([priority])
  @@index([urgency])
  @@index([requiresAction])
  @@index([requiresReply])
  @@map("message_analyses")
}

/// Actionable item extracted from an analyzed message
model MessageActionItem {
  id          String    @id @default(uuid())
  messageId   String    @map("message_id")
  userId      String    @map("user_id")
  title       String
  description String?
  priority    String    @default("MEDIUM")
  dueDate     DateTime? @map("due_date")
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([messageId])
  @@index([status])
  @@index([dueDate])
  @@map("message_action_items")
}

/// User-defined or automated message category tag
model MessageLabel {
  id          String                   @id @default(uuid())
  userId      String                   @map("user_id")
  name        String
  color       String?
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments MessageLabelAssignment[]

  @@unique([userId, name])
  @@index([userId])
  @@map("message_labels")
}

/// Join table for messages and labels
model MessageLabelAssignment {
  id        String       @id @default(uuid())
  messageId String       @map("message_id")
  labelId   String       @map("label_id")

  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  label     MessageLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([messageId, labelId])
  @@index([messageId])
  @@index([labelId])
  @@map("message_label_assignments")
}

// ============================================================
// Module 08: Personal Memory & Knowledge System (RAG)
// ============================================================

/// Long-term personal memory document model
model Memory {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  title        String
  content      String
  category     String
  importance   String    @default("MEDIUM")
  source       String    @default("MANUAL")
  status       String    @default("PENDING")
  errorMessage String?   @map("error_message")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks         MemoryChunk[]
  tagAssignments MemoryTagAssignment[]
  accessLogs     MemoryAccessLog[]

  @@index([userId])
  @@index([category])
  @@index([importance])
  @@index([status])
  @@index([createdAt])
  @@map("memories")
}

/// Chunked memory segment with local vector embeddings
model MemoryChunk {
  id         String   @id @default(uuid())
  memoryId   String   @map("memory_id")
  userId     String   @map("user_id")
  chunkIndex Int      @map("chunk_index")
  content    String
  tokenCount Int      @default(0) @map("token_count")
  embedding  Float[]
  dimensions Int      @default(0)
  modelName  String   @default("nomic-embed-text") @map("model_name")
  createdAt  DateTime @default(now()) @map("created_at")

  memory     Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memoryId, chunkIndex])
  @@index([userId])
  @@index([memoryId])
  @@map("memory_chunks")
}

/// Reusable user tags for organizing personal memories
model MemoryTag {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  name        String
  createdAt   DateTime              @default(now()) @map("created_at")

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments MemoryTagAssignment[]

  @@unique([userId, name])
  @@index([userId])
  @@map("memory_tags")
}

/// Association between memories and tags
model MemoryTagAssignment {
  id       String    @id @default(uuid())
  memoryId String    @map("memory_id")
  tagId    String    @map("tag_id")

  memory   Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  tag      MemoryTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([memoryId, tagId])
  @@index([memoryId])
  @@index([tagId])
  @@map("memory_tag_assignments")
}

/// Audit and analytics log for memory retrieval and operations
model MemoryAccessLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  memoryId   String?  @map("memory_id")
  action     String
  query      String?
  similarity Float?
  timestamp  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory     Memory?  @relation(fields: [memoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([memoryId])
  @@index([action])
  @@index([timestamp])
  @@map("memory_access_logs")
}
