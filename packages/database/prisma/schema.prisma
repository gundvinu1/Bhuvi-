// ============================================================
// BHUVI – Prisma Schema
// Module 03: Database & Infrastructure Foundation
// Module 06: AI Agent Orchestrator Foundation
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// User account model for BHUVI identity and authentication
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plans        AgentPlan[]
  approvals    ApprovalRequest[]
  messages     Message[]
  actionItems  MessageActionItem[]
  labels       MessageLabel[]
  memories     Memory[]
  memoryChunks MemoryChunk[]
  memoryTags   MemoryTag[]
  accessLogs   MemoryAccessLog[]

  // Module 09: Gmail Integration
  gmailConnections GmailConnection[]
  gmailMessages    GmailMessage[]
  gmailAttachments GmailAttachment[]
  gmailSyncStates  GmailSyncState[]

  // Module 10: WhatsApp Integration
  whatsappConnections   WhatsAppConnection[]
  whatsappContacts      WhatsAppContact[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
  whatsappDrafts        WhatsAppMessageDraft[]

  @@index([email])
  @@map("users")
}

/// Orchestrated AI plan generated from a user prompt
model AgentPlan {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  title               String
  prompt              String
  intentCategory      String   @map("intent_category")
  status              String   @default("PENDING")
  clarificationNeeded Boolean  @default(false) @map("clarification_needed")
  explanation         String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps      AgentPlanStep[]
  executions AgentExecution[]
  approvals  ApprovalRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("agent_plans")
}

/// Individual step within an orchestrated AI plan
model AgentPlanStep {
  id               String    @id @default(uuid())
  planId           String    @map("plan_id")
  stepIndex        Int       @map("step_index")
  stepKey          String    @map("step_key")
  title            String
  description      String
  assignedAgent    String    @map("assigned_agent")
  dependencies     String[]  @default([])
  status           String    @default("PENDING")
  requiresApproval Boolean   @default(false) @map("requires_approval")
  output           Json?
  error            String?
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")

  plan      AgentPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  approvals ApprovalRequest[]

  @@unique([planId, stepKey])
  @@index([planId])
  @@index([status])
  @@map("agent_plan_steps")
}

/// Execution tracking run for an AI plan
model AgentExecution {
  id            String    @id @default(uuid())
  planId        String    @map("plan_id")
  status        String    @default("RUNNING")
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  error         String?
  triggerSource String    @default("MANUAL") @map("trigger_source")
  logs          Json?

  plan AgentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
  @@map("agent_executions")
}

/// Human approval request for sensitive proposals
model ApprovalRequest {
  id             String    @id @default(uuid())
  planId         String    @map("plan_id")
  stepId         String?   @map("step_id")
  userId         String    @map("user_id")
  actionType     String    @map("action_type")
  description    String
  proposalData   Json      @map("proposal_data")
  status         String    @default("PENDING")
  decisionReason String?   @map("decision_reason")
  decidedBy      String?   @map("decided_by")
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan AgentPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  step AgentPlanStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("approval_requests")
}

// ============================================================
// Module 07: Message Intelligence Engine
// ============================================================

/// Ingested message model for intelligence processing
model Message {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  source           String   @default("MANUAL")
  senderName       String   @map("sender_name")
  senderIdentifier String?  @map("sender_identifier")
  subject          String?
  content          String
  contentHash      String   @map("content_hash")
  processingStatus String   @default("RECEIVED") @map("processing_status")
  receivedAt       DateTime @default(now()) @map("received_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis         MessageAnalysis?
  actionItems      MessageActionItem[]
  labelAssignments MessageLabelAssignment[]
  gmailMessage     GmailMessage?
  whatsappMessage  WhatsAppMessage?

  @@index([userId])
  @@index([processingStatus])
  @@index([receivedAt])
  @@index([userId, contentHash])
  @@map("messages")
}

/// Structured AI analysis for an ingested message
model MessageAnalysis {
  id                  String   @id @default(uuid())
  messageId           String   @unique @map("message_id")
  category            String
  priority            String
  priorityExplanation String?  @map("priority_explanation")
  urgency             String
  intent              String
  sentiment           String
  summary             String
  requiresReply       Boolean  @default(false) @map("requires_reply")
  requiresAction      Boolean  @default(false) @map("requires_action")
  confidence          Float    @default(0.0)
  extractedEntities   Json     @default("[]") @map("extracted_entities")
  analysisMetadata    Json?    @map("analysis_metadata")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([priority])
  @@index([urgency])
  @@index([requiresAction])
  @@index([requiresReply])
  @@map("message_analyses")
}

/// Actionable item extracted from an analyzed message
model MessageActionItem {
  id          String    @id @default(uuid())
  messageId   String    @map("message_id")
  userId      String    @map("user_id")
  title       String
  description String?
  priority    String    @default("MEDIUM")
  dueDate     DateTime? @map("due_date")
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([messageId])
  @@index([status])
  @@index([dueDate])
  @@map("message_action_items")
}

/// User-defined or automated message category tag
model MessageLabel {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments MessageLabelAssignment[]

  @@unique([userId, name])
  @@index([userId])
  @@map("message_labels")
}

/// Join table for messages and labels
model MessageLabelAssignment {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  labelId   String @map("label_id")

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  label   MessageLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([messageId, labelId])
  @@index([messageId])
  @@index([labelId])
  @@map("message_label_assignments")
}

// ============================================================
// Module 08: Personal Memory & Knowledge System (RAG)
// ============================================================

/// Long-term personal memory document model
model Memory {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  title        String
  content      String
  category     String
  importance   String    @default("MEDIUM")
  source       String    @default("MANUAL")
  status       String    @default("PENDING")
  errorMessage String?   @map("error_message")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks         MemoryChunk[]
  tagAssignments MemoryTagAssignment[]
  accessLogs     MemoryAccessLog[]

  @@index([userId])
  @@index([category])
  @@index([importance])
  @@index([status])
  @@index([createdAt])
  @@map("memories")
}

/// Chunked memory segment with local vector embeddings
model MemoryChunk {
  id         String   @id @default(uuid())
  memoryId   String   @map("memory_id")
  userId     String   @map("user_id")
  chunkIndex Int      @map("chunk_index")
  content    String
  tokenCount Int      @default(0) @map("token_count")
  embedding  Float[]
  dimensions Int      @default(0)
  modelName  String   @default("nomic-embed-text") @map("model_name")
  createdAt  DateTime @default(now()) @map("created_at")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memoryId, chunkIndex])
  @@index([userId])
  @@index([memoryId])
  @@map("memory_chunks")
}

/// Reusable user tags for organizing personal memories
model MemoryTag {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments MemoryTagAssignment[]

  @@unique([userId, name])
  @@index([userId])
  @@map("memory_tags")
}

/// Association between memories and tags
model MemoryTagAssignment {
  id       String @id @default(uuid())
  memoryId String @map("memory_id")
  tagId    String @map("tag_id")

  memory Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  tag    MemoryTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([memoryId, tagId])
  @@index([memoryId])
  @@index([tagId])
  @@map("memory_tag_assignments")
}

/// Audit and analytics log for memory retrieval and operations
model MemoryAccessLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  memoryId   String?  @map("memory_id")
  action     String
  query      String?
  similarity Float?
  timestamp  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory Memory? @relation(fields: [memoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([memoryId])
  @@index([action])
  @@index([timestamp])
  @@map("memory_access_logs")
}

// ============================================================
// Module 09: Gmail Integration
// ============================================================

/// Authorized Gmail OAuth connection for a user
model GmailConnection {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  googleAccountEmail    String    @map("google_account_email")
  googleAccountId       String?   @map("google_account_id")
  encryptedAccessToken  String    @map("encrypted_access_token")
  encryptedRefreshToken String?   @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  scopes                String[]  @default([])
  connectionStatus      String    @default("CONNECTED") @map("connection_status")
  lastSyncedAt          DateTime? @map("last_synced_at")
  lastHistoryId         String?   @map("last_history_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   GmailMessage[]
  syncStates GmailSyncState[]

  @@unique([userId, googleAccountEmail])
  @@index([userId])
  @@index([connectionStatus])
  @@map("gmail_connections")
}

/// Synchronized Gmail email message
model GmailMessage {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  gmailConnectionId String   @map("gmail_connection_id")
  providerMessageId String   @map("provider_message_id")
  providerThreadId  String   @map("provider_thread_id")
  senderName        String?  @map("sender_name")
  senderEmail       String   @map("sender_email")
  recipientEmails   String[] @default([]) @map("recipient_emails")
  ccEmails          String[] @default([]) @map("cc_emails")
  subject           String   @default("")
  snippet           String?
  bodyText          String   @map("body_text")
  bodyHtml          String?  @map("body_html")
  receivedAt        DateTime @map("received_at")
  isRead            Boolean  @default(false) @map("is_read")
  hasAttachments    Boolean  @default(false) @map("has_attachments")
  labels            String[] @default([])
  syncStatus        String   @default("SYNCHRONIZED") @map("sync_status")
  messageId         String?  @unique @map("message_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection  GmailConnection   @relation(fields: [gmailConnectionId], references: [id], onDelete: Cascade)
  message     Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  attachments GmailAttachment[]

  @@unique([gmailConnectionId, providerMessageId])
  @@index([userId])
  @@index([providerMessageId])
  @@index([providerThreadId])
  @@index([senderEmail])
  @@index([receivedAt])
  @@index([isRead])
  @@map("gmail_messages")
}

/// Metadata for attachments on a synchronized Gmail message
model GmailAttachment {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  gmailMessageId       String   @map("gmail_message_id")
  providerAttachmentId String   @map("provider_attachment_id")
  filename             String
  mimeType             String   @map("mime_type")
  size                 Int      @default(0)
  downloadStatus       String   @default("METADATA_ONLY") @map("download_status")
  createdAt            DateTime @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message GmailMessage @relation(fields: [gmailMessageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gmailMessageId])
  @@map("gmail_attachments")
}

/// Synchronization run state and telemetry for Gmail
model GmailSyncState {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  gmailConnectionId    String    @map("gmail_connection_id")
  lastHistoryId        String?   @map("last_history_id")
  lastSuccessfulSyncAt DateTime? @map("last_successful_sync_at")
  lastAttemptAt        DateTime  @default(now()) @map("last_attempt_at")
  syncStatus           String    @default("IDLE") @map("sync_status")
  errorMessage         String?   @map("error_message")
  syncedCount          Int       @default(0) @map("synced_count")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection GmailConnection @relation(fields: [gmailConnectionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gmailConnectionId])
  @@index([syncStatus])
  @@map("gmail_sync_states")
}

// ============================================================
// Module 10: WhatsApp Business Integration
// ============================================================

/// WhatsApp Business Account connection for a user
model WhatsAppConnection {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  businessAccountId    String    @map("business_account_id")
  phoneNumberId        String    @map("phone_number_id")
  displayPhoneNumber   String    @map("display_phone_number")
  displayName          String    @map("display_name")
  encryptedAccessToken String    @map("encrypted_access_token")
  tokenIV              String    @map("token_iv")
  tokenAuthTag         String    @map("token_auth_tag")
  status               String    @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  lastActivityAt       DateTime? @map("last_activity_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts      WhatsAppContact[]
  conversations WhatsAppConversation[]
  messages      WhatsAppMessage[]
  webhookEvents WhatsAppWebhookEvent[]
  drafts        WhatsAppMessageDraft[]

  @@unique([userId, phoneNumberId])
  @@index([userId])
  @@index([phoneNumberId])
  @@index([status])
  @@map("whatsapp_connections")
}

/// Resolved WhatsApp Contact / Customer Profile
model WhatsAppContact {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  connectionId String   @map("connection_id")
  waId         String   @map("wa_id") // WhatsApp ID / phone number
  name         String?
  profileData  Json?    @map("profile_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection    WhatsAppConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversations WhatsAppConversation[]

  @@unique([connectionId, waId])
  @@index([userId])
  @@index([connectionId])
  @@index([waId])
  @@map("whatsapp_contacts")
}

/// WhatsApp Conversation Thread between a business number and a contact
model WhatsAppConversation {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  connectionId       String    @map("connection_id")
  contactId          String    @map("contact_id")
  status             String    @default("ACTIVE") // ACTIVE, ARCHIVED, SPAM
  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String?   @map("last_message_preview")
  unreadCount        Int       @default(0) @map("unread_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection WhatsAppConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contact    WhatsAppContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages   WhatsAppMessage[]
  drafts     WhatsAppMessageDraft[]

  @@unique([connectionId, contactId])
  @@index([userId])
  @@index([connectionId])
  @@index([contactId])
  @@index([lastMessageAt])
  @@map("whatsapp_conversations")
}

/// Incoming or Outgoing WhatsApp message
model WhatsAppMessage {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  connectionId      String   @map("connection_id")
  conversationId    String   @map("conversation_id")
  externalMessageId String   @map("external_message_id") // Meta wamid.HBg...
  direction         String   @map("direction") // INCOMING, OUTGOING
  messageType       String   @map("message_type") // text, image, document, audio, video, location, contacts, interactive
  textContent       String?  @map("text_content")
  mediaMetadata     Json?    @map("media_metadata")
  deliveryStatus    String   @default("DELIVERED") @map("delivery_status") // SENT, DELIVERED, READ, FAILED
  timestamp         DateTime @map("timestamp")
  messageId         String?  @unique @map("message_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   WhatsAppConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?             @relation(fields: [messageId], references: [id], onDelete: SetNull)
  media        WhatsAppMedia[]

  @@unique([connectionId, externalMessageId])
  @@index([userId])
  @@index([connectionId])
  @@index([conversationId])
  @@index([externalMessageId])
  @@index([timestamp])
  @@index([direction])
  @@index([deliveryStatus])
  @@map("whatsapp_messages")
}

/// Metadata and storage reference for media attached to a WhatsApp message
model WhatsAppMedia {
  id          String   @id @default(uuid())
  messageId   String   @map("message_id")
  mediaId     String   @map("media_id")
  mimeType    String   @map("mime_type")
  filename    String?
  fileSize    Int?     @map("file_size")
  storagePath String?  @map("storage_path")
  createdAt   DateTime @default(now()) @map("created_at")

  message WhatsAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([mediaId])
  @@map("whatsapp_media")
}

/// Raw Meta webhook event audit and deduplication log
model WhatsAppWebhookEvent {
  id               String    @id @default(uuid())
  connectionId     String?   @map("connection_id")
  eventId          String    @unique @map("event_id") // Meta deduplication key / wamid
  eventType        String    @map("event_type") // messages, message_status
  payload          Json
  processingStatus String    @default("PENDING") @map("processing_status") // PENDING, PROCESSED, FAILED
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")
  errorMessage     String?   @map("error_message")

  connection WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([processingStatus])
  @@index([receivedAt])
  @@map("whatsapp_webhook_events")
}

/// Outbound WhatsApp message draft requiring explicit human approval
model WhatsAppMessageDraft {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  connectionId     String    @map("connection_id")
  conversationId   String    @map("conversation_id")
  recipientPhone   String    @map("recipient_phone")
  messageType      String    @default("text") @map("message_type")
  content          String
  templateName     String?   @map("template_name")
  templateParams   Json?     @map("template_params")
  approvalStatus   String    @default("PENDING_APPROVAL") @map("approval_status") // PENDING_APPROVAL, APPROVED, REJECTED, SENT
  approvedByUserId String?   @map("approved_by_user_id")
  approvedAt       DateTime? @map("approved_at")
  sentAt           DateTime? @map("sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   WhatsAppConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectionId])
  @@index([conversationId])
  @@index([approvalStatus])
  @@map("whatsapp_message_drafts")
}
