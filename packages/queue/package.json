{
  "name": "@bhuvi/queue",
  "version": "1.0.0",
  "private": true,
  "description": "BullMQ and Redis queue foundation for BHUVI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@bhuvi/shared": "workspace:*",
    "bullmq": "^5.8.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  }
}
